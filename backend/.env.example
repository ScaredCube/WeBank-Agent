# App
DEBUG=true
DATABASE_URL=sqlite:///./bank_agent.db
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
DEMO_DISPLAY_NAME=演示用户
# Seed a second account and holding so the asset drag matrix is demoable.
DEMO_MULTI_ASSETS=true

# Risk (China local time; demo policy)
RISK_NIGHT_START_HOUR=0
RISK_NIGHT_END_HOUR=6

# Local demonstration only; simulated verification is disabled when DEBUG=false.
DEMO_VERIFICATION_CODE=123456

# Independent 32-byte URL-safe base64 keys; generate two distinct values locally.
# Missing or invalid keys fail closed for sensitive values. Never commit real keys.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_VERSION=v1
DATA_ENCRYPTION_PREVIOUS_KEYS={}
DATA_HMAC_KEY=

# LLM (OpenAI compatible)
# Required: the backend refuses to start without a working OpenAI-compatible key.
LLM_BASE_URL=https://tokendance.space/gateway/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash-1017
# JSON object for extra HTTP headers, e.g. {"X-Project-ID":"example"}.
# Do not duplicate Authorization; LLM_API_KEY already creates a Bearer header.
LLM_EXTRA_HEADERS={}
LLM_TIMEOUT=60
LLM_MAX_HISTORY=20

# Tool-call guard. Active only when a real LLM is configured; failures deny the call.
GUARD_TIMEOUT_SECONDS=8

# Circuit breaker and rate limit (demo defaults).
SECURITY_FAILURE_THRESHOLD=5
SECURITY_FAILURE_WINDOW_SECONDS=600
SECURITY_LOCK_SECONDS=900
SECURITY_RATE_LIMIT_REQUESTS=60
SECURITY_RATE_WINDOW_SECONDS=60
# Demo-only manual unlock code; route is disabled when DEBUG=false.
SECURITY_UNLOCK_CODE=246810
