# App
DEBUG=true
DATABASE_URL=sqlite:///./bank_agent.db
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
DEMO_DISPLAY_NAME=演示用户

# Risk (China local time; demo policy)
RISK_NIGHT_START_HOUR=0
RISK_NIGHT_END_HOUR=6

# Local demonstration only; simulated verification is disabled when DEBUG=false.
DEMO_VERIFICATION_CODE=123456

# LLM (OpenAI compatible)
# Leave LLM_API_KEY empty to run the offline mock provider.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_HISTORY=20
